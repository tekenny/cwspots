[Unit]
Description=Refresh cty.dat DXCC data for CW Spotter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/bin/curl -fsSL -o /opt/cwspots/cty.dat.tmp https://www.country-files.com/cty/cty.dat && /usr/bin/mv /opt/cwspots/cty.dat.tmp /opt/cwspots/cty.dat'
ExecStartPost=/usr/bin/systemctl restart cwspots
